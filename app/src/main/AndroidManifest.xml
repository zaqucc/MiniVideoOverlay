<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- No permissions: files are accessed through the Storage Access Framework
         (ACTION_OPEN_DOCUMENT) and saved through MediaStore. -->

    <application
        android:hardwareAccelerated="true"
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="MiniVideoOverlay"
        android:supportsRtl="false"
        android:theme="@android:style/Theme.DeviceDefault.Light.DarkActionBar">

        <service
            android:name=".ExportService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProcessing" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
